          "type": "select",
          "label": {
            "en": "Deployment filter",
            "fr": "Filtre des déploiements"
          },
          "options": [
            {
              "value": "all",
              "label": {
                "en": "All",
                "fr": "Tous"
              }
            },
            {
              "value": "failed",
              "label": {
                "en": "Failed",
                "fr": "Échoués"
              }
            },
            {
              "value": "success",
              "label": {
                "en": "Succeeded",
                "fr": "Réussis"
              }
            },
            {
              "value": "active",
              "label": {
                "en": "Queued / in progress",
                "fr": "En attente / en cours"
              }
            }
          ],
          "default": "all"
        },
        {
          "key": "history_page",
          "type": "number",
          "label": {
            "en": "History page (50 attempts)",
            "fr": "Page d’historique (50 tentatives)"
          },
          "default": 1,
          "min": 1,
          "max": 1000
        },
        {
          "key": "layout",
          "type": "select",
          "label": {
            "en": "Layout",
            "fr": "Présentation"
          },
          "options": [
            {
              "value": "list",
              "label": {
                "en": "Chronological rows",
                "fr": "Lignes chronologiques"
              }
            },
            {
              "value": "cards",
              "label": {
                "en": "Detailed cards",
                "fr": "Cartes détaillées"
              }
            },
            {
              "value": "grid",
              "label": {
                "en": "Card grid",
                "fr": "Grille de cartes"
              }
            }
          ],
          "default": "list"
        },
        {
          "key": "limit",
          "type": "number",
          "label": {
            "en": "Visible items",
            "fr": "Éléments visibles"
          },
          "default": 6,
          "min": 1,
          "max": 12,
          "description": {
            "en": "Rows: up to 8, fewer when extra details are visible. Cards: 8. Grid: 12.",
            "fr": "Lignes : jusqu’à 8, moins si d’autres détails sont visibles. Cartes : 8. Grille : 12."
          }
        },
        {
          "key": "fields",
          "type": "multi_select",
          "label": {
            "en": "Visible details",
            "fr": "Informations visibles"
          },
          "default": [],
          "options": [
            {
              "value": "status",
              "label": {
                "en": "Current status",
                "fr": "État actuel"
              }
            },
            {
              "value": "server",
              "label": {
                "en": "Server",
                "fr": "Serveur"
              }
            },
            {
              "value": "type",
              "label": {
                "en": "Resource type",
                "fr": "Type de ressource"
              }
            },
            {
              "value": "commit",
              "label": {
                "en": "Git commit",
                "fr": "Commit Git"
              }
            },
            {
              "value": "duration",
              "label": {
                "en": "Total duration (including queue)",
                "fr": "Durée totale (attente comprise)"
              }
            }
