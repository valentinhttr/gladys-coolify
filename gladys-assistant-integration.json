        {
          "key": "show_updated",
          "type": "boolean",
          "default": true,
          "label": {
            "en": "Show check time",
            "fr": "Afficher la date de vérification"
          }
        },
        {
          "key": "refresh_interval",
          "type": "number",
          "label": {
            "en": "Widget refresh (seconds)",
            "fr": "Actualisation du widget (secondes)"
          },
          "default": 60,
          "min": 30,
          "max": 3600,
          "description": {
            "en": "Inventory freshness also depends on the integration polling interval.",
            "fr": "La fraîcheur de l’inventaire dépend aussi de l’intervalle de l’intégration."
          }
        },
        {
          "key": "show_refresh",
          "type": "boolean",
          "label": {
            "en": "Show refresh button",
            "fr": "Afficher le bouton Actualiser"
          },
          "default": true
        }
      ]
    },
    {
      "key": "health",
      "label": {
        "en": "HTTP availability",
        "fr": "Disponibilité HTTP"
      },
      "description": {
        "en": "HTTP checks every 5 minutes, with persistent 24-hour, 7-day and 30-day history.",
        "fr": "Contrôles HTTP toutes les 5 minutes, avec historique persistant sur 24 h, 7 jours et 30 jours."
      },
      "icon": "activity",
      "action_timeout_seconds": 15,
      "settings": [
        {
          "key": "title",
          "type": "string",
          "label": {
            "en": "Custom title",
            "fr": "Titre personnalisé"
          }
        },
        {
          "key": "resource",
          "type": "select",
          "label": {
            "en": "Application",
            "fr": "Application"
          },
          "source": "devices",
          "required": true,
          "description": {
            "en": "Choose an imported application with a Coolify domain. Monitoring is already automatic by default, independently of the widget.",
            "fr": "Choisissez une application ajoutée avec un domaine Coolify. La surveillance est déjà automatique par défaut, indépendamment du widget."
          }
        },
        {
          "key": "auto_monitor",
          "type": "boolean",
          "default": true,
          "label": {
            "en": "Add application in manual mode",
            "fr": "Ajouter l’application en mode manuel"
          },
          "description": {
            "en": "In Manual selection mode, this widget adds its application to the monitored list. All applications mode already monitors it; Disabled mode stays disabled. Removing a widget does not stop monitoring.",
            "fr": "En Sélection manuelle, ce widget ajoute son application à la liste surveillée. Le mode Toutes les applications la surveille déjà ; le mode Désactivée reste désactivé. Supprimer un widget n’arrête pas la surveillance."
          }
        },
        {
          "key": "show_stats",
          "type": "boolean",
          "default": true,
          "label": {
            "en": "Show statistics",
            "fr": "Afficher les statistiques"
          }
        },
        {
          "key": "show_chart",
          "type": "boolean",
          "default": true,
          "label": {
            "en": "Show response time chart",
            "fr": "Afficher la courbe de réponse"
          }
        },
        {
          "key": "chart_type",
          "type": "select",
          "default": "area",
          "label": {
            "en": "Period and chart",
            "fr": "Période et graphique"
          },
          "options": [
            {
              "value": "area",
              "label": {
                "en": "24 hours · filled curve",
                "fr": "24 heures · courbe remplie"
              }
            },
            {
              "value": "area_7d",
              "label": {
                "en": "7 days · filled curve",
                "fr": "7 jours · courbe remplie"
              }
            },
            {
              "value": "area_30d",
              "label": {
                "en": "30 days · filled curve",
                "fr": "30 jours · courbe remplie"
              }
            },
            {
              "value": "line",
              "label": {
                "en": "24 hours · line",
                "fr": "24 heures · courbe simple"
              }
            },
            {
              "value": "line_7d",
              "label": {
                "en": "7 days · line",
                "fr": "7 jours · courbe simple"
              }
            },
            {
              "value": "line_30d",
              "label": {
                "en": "30 days · line",
                "fr": "30 jours · courbe simple"
              }
            }
          ],
          "description": {
            "en": "Statistics use every check in the period. Chart intervals: 5 min / 1 h / 3 h. Red markers identify up to 8 recent intervals with failures. Missing timings use bars.",
            "fr": "Les statistiques utilisent tous les contrôles de la période. Tranches du graphique : 5 min / 1 h / 3 h. Les repères rouges indiquent jusqu’à 8 tranches récentes avec échecs. Les temps manquants utilisent des barres."
          }
        },
        {
          "key": "fields",
          "type": "multi_select",
          "default": ["url", "code", "checked", "window"],
          "label": {
            "en": "Visible details",
            "fr": "Informations visibles"
          },
          "options": [
            {
              "value": "url",
              "label": {
                "en": "Domain",
                "fr": "Domaine"
              }
            },
            {
              "value": "code",
              "label": {
                "en": "HTTP code",
                "fr": "Code HTTP"
              }
            },
            {
              "value": "checked",
              "label": {
                "en": "Check time",
                "fr": "Date de vérification"
              }
            },
            {
              "value": "window",
              "label": {
                "en": "Start of sample window",
                "fr": "Début de la fenêtre mesurée"
              }
            }
          ]
        },
        {
          "key": "show_link",
          "type": "boolean",
          "default": true,
          "label": {
            "en": "Show application link",
            "fr": "Afficher le lien de l’application"
          }
        },
        {
          "key": "refresh_interval",
          "type": "number",
          "label": {
            "en": "Widget refresh (seconds)",
            "fr": "Actualisation du widget (secondes)"
          },
          "default": 60,
          "min": 30,
          "max": 3600,
          "description": {
            "en": "Refreshes the display only. HTTP probes run every 5 minutes, independently of widget views and Coolify inventory polling.",
            "fr": "Actualise uniquement l’affichage. Les sondes HTTP passent toutes les 5 minutes, indépendamment des vues du widget et de la collecte Coolify."
          }
        },
        {
          "key": "show_refresh",
          "type": "boolean",
          "label": {
            "en": "Show refresh button",
            "fr": "Afficher le bouton Actualiser"
          },
          "default": true
        }
      ]
    }
  ],
